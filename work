<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Work & Impact | Bayt al-ʿĀfiyah Foundation</title>
<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}
html{
    scroll-behavior:smooth;
}
body{
    background:#f8f9fb;
    color:#333;
}
/* HEADER */
header{
    background:#0B3D91;
    color:white;
    padding:20px;
    position:sticky;
    top:0;
    z-index:1000;
}
nav{
    display:flex;
    justify-content:space-between;
    align-items:center;
    max-width:1200px;
    margin:auto;
}
nav h2{
    font-size:24px;
}
nav a{
    color:white;
    text-decoration:none;
    margin-left:20px;
}
nav a:hover{
    color:#D4AF37;
}
/* HERO */
.hero{
    min-height:55vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    background:
    linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.55)),
    url('https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=1400&q=80');
    background-size:cover;
    background-position:center;
    color:white;
    padding:60px 20px;
}
.hero-content{
    max-width:850px;
}
.hero h1{
    font-size:50px;
    margin-bottom:18px;
}
.hero .tagline{
    color:#FFD700;
    font-size:23px;
    font-weight:bold;
    letter-spacing:2px;
    margin-bottom:20px;
}
.hero p{
    font-size:20px;
    line-height:1.8;
}
/* MAIN CONTAINER */
.container{
    max-width:1150px;
    margin:auto;
    padding:70px 20px;
}
/* INTRO */
.intro{
    text-align:center;
    max-width:850px;
    margin:0 auto 60px;
}
.intro h2{
    color:#0B3D91;
    font-size:36px;
    margin-bottom:18px;
}
.intro p{
    color:#555;
    font-size:18px;
    line-height:1.8;
}
/* WORK SECTION */
.work-section{
    background:white;
    border-radius:20px;
    margin-bottom:45px;
    padding:40px;
    box-shadow:0 8px 25px rgba(0,0,0,.07);
}
.work-section h2{
    color:#0B3D91;
    font-size:30px;
    margin-bottom:15px;
}
.work-section p{
    color:#555;
    font-size:17px;
    line-height:1.8;
}
/* FLOOD PHOTO */
.photo-placeholder{
    margin-top:25px;
    height:280px;
    border-radius:15px;
    background:#eef2f7;
    border:2px dashed #b9c3d0;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    color:#687585;
    font-size:17px;
}
.photo-placeholder span{
    max-width:500px;
}
/* STATISTICS */
.stats{
    display:flex;
    justify-content:center;
    gap:25px;
    flex-wrap:wrap;
    margin-top:30px;
}
.stat{
    min-width:180px;
    padding:22px;
    background:#f7fafc;
    border-radius:15px;
    text-align:center;
    border-top:4px solid #D4AF37;
}
.stat h3{
    color:#0B3D91;
    font-size:32px;
    margin-bottom:5px;
}
.stat p{
    font-size:15px;
    color:#666;
}
/* EDUCATION HIGHLIGHT */
.education-highlight{
    background:#0B3D91;
    color:white;
    border-radius:20px;
    padding:45px 35px;
    margin-top:25px;
}
.education-highlight h2{
    color:white;
    margin-bottom:15px;
}
.education-highlight p{
    color:white;
}
.education-highlight .education-stat{
    margin-top:25px;
    text-align:center;
}
.education-stat strong{
    display:block;
    font-size:48px;
    color:#FFD700;
}
.education-stat span{
    font-size:17px;
}
/* COMMUNITY SUPPORT */
.community-box{
    margin-top:25px;
    padding:25px;
    background:#f7fafc;
    border-left:5px solid #D4AF37;
    border-radius:10px;
}
.community-box p{
    margin:0;
}
/* FUTURE */
.future{
    text-align:center;
    padding:50px 20px 20px;
}
.future h2{
    color:#0B3D91;
    font-size:35px;
    margin-bottom:18px;
}
.future p{
    max-width:850px;
    margin:auto;
    color:#555;
    font-size:18px;
    line-height:1.9;
}
/* BACK BUTTON */
.back-section{
    text-align:center;
    padding:10px 20px 70px;
}
.back-btn{
    display:inline-block;
    background:#D4AF37;
    color:white;
    text-decoration:none;
    padding:15px 35px;
    border-radius:50px;
    font-weight:bold;
    font-size:17px;
    transition:.3s;
}
.back-btn:hover{
    background:#0B3D91;
    transform:translateY(-3px);
}
/* FOOTER */
footer{
    background:#0B3D91;
    color:white;
    text-align:center;
    padding:35px 20px;
}
footer p{
    margin-top:8px;
}
/* MOBILE */
@media(max-width:700px){
    nav{
        flex-direction:column;
        gap:15px;
    }
    nav a{
        margin:0 8px;
        font-size:14px;
    }
    .hero{
        min-height:50vh;
    }
    .hero h1{
        font-size:38px;
    }
    .hero .tagline{
        font-size:19px;
    }
    .hero p{
        font-size:17px;
    }
    .work-section{
        padding:28px 22px;
    }
    .work-section h2{
        font-size:26px;
    }
}
</style>
</head>
